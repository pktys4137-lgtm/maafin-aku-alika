ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$PASTE_YOUR_BCRYPTJS_HASH_HERE
SESSION_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
NODE_ENV=production

